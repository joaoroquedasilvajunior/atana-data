# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
.env

# DuckDB local databases (we use MotherDuck cloud)
*.duckdb
*.duckdb.wal
*.duckdb.tmp

# Editor
.vscode/
.idea/
.DS_Store

# Secrets — NEVER commit tokens
.motherduck_token
secrets.json
*.token

# Intermediate ETL output
etl/_tmp/
etl/__cache__/

# DB-updater / ETL --staging output — throwaway, diffed against live then discarded
raw/*/_staging/

# Pre-refresh rollback snapshots — insurance only, never committed
raw/salic/projetos_pre_slice_*.parquet

# OS
Thumbs.db

# sed backups
*.bak

# Single big files replaced by partitioned subdirs (cleanup after sandbox couldn't remove)
raw/unctad/goods_value.parquet
raw/unctad/goods_growth.parquet
raw/unctad/_placeholder.md
*.log
raw/*/_source/
raw/pnab/_source/
raw/ilo_ai/_source/
